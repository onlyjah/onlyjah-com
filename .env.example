# Public browser configuration only. Copy to .env.local and use your existing app.
VITE_CLERK_PUBLISHABLE_KEY=
# Optional shared-app SSO. Leave satellite settings blank on the primary site.
VITE_CLERK_PRIMARY_URL=
VITE_CLERK_SATELLITE_DOMAIN=
# Comma-separated exact origins; configure the same approved list in Clerk.
VITE_CLERK_ALLOWED_REDIRECT_ORIGINS=
# Optional: the development branch's public Neon Data API URL, ending in /rest/v1.
# This is NOT a Postgres connection string. JWT verification and RLS are required.
VITE_NEON_DATA_API_URL=
# Optional: verified Neon Auth base URL for short-lived anonymous read tokens.
# This serves public collections only; member signup/sign-in remains Clerk.
VITE_NEON_PUBLIC_AUTH_URL=
# These are public settings read by the frontend. Match Clerk and Neon
# development environments before setting the optional endpoint; restart pnpm dev.
# Prefer .env.development.local and .env.production.local for separate targets.
# .env.local loads in BOTH modes; .env.prod requires an explicit --mode prod.
# DATABASE_URL, DATABASE_URL_DIRECT and CLERK_SECRET_KEY belong in the separate
# trusted backend's environment. Convex is not integrated; no Convex setting is required.

# Public testing marker. COPY_STAGE=testing is a build-script setting, not a browser secret.
VITE_RELEASE_STAGE=testing

# Hosting-only Access settings. Never use a VITE_ prefix for these.
# pnpm start on Railway testing requires all three; missing values deny access.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
STAGING_ALLOWED_EMAILS=
# Set true to exercise the origin gate outside Railway, using pnpm preview.
STAGING_ACCESS_REQUIRED=false
